{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "/tmp/adapt-next-offline-L3A4XS/types/**/*.ts",
    "/tmp/next-off/types/**/*.ts",
    "next-env.d.ts",
    "/tmp/adapt-next-offline-gaDWdS/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "server.mjs"
  ]
}
